# ---------------------------------------------------------------
# 학생 과제: 아래 각 줄이 무엇을 하는지 주석으로 설명을 달아보세요.
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# guestbook 이미지를 만드는 레시피
# ---------------------------------------------------------------

# 기반 이미지: 파이썬 3.12이 설치된 경량(slim) 리눅스 이미지에서 시작
FROM python:3.12-slim

# 컨테이너 안의 작업 디렉터리를 /app으로 지정 (없으면 자동 생성, cd와 비슷)
WORKDIR /app

# 라이브러리 목록 파일만 먼저 복사 (캐시를 활용하기 위해 코드보다 앞에 둠)
COPY requirements.txt .

# 빌드할 때 Flask 등 필요한 라이브러리를 설치 (결과가 이미지에 남음)
# --no-cache-dir: pip 캐시를 저장하지 않아 이미지 크기를 줄임
RUN pip install --no-cache-dir -r requirements.txt

# 나머지 소스 코드 전체(app.py, templates 등)를 /app으로 복사
# 코드는 자주 바뀌므로 pip install 뒤에 둬야 재빌드가 빠름
COPY . .

# root가 아닌 일반 사용자(appuser)를 만들고, 이후부터 그 사용자로 실행 (보안)
RUN useradd -m appuser
USER appuser

# 환경 변수 기본값을 이미지에 구움 (docker run -e로 덮어쓸 수 있음)
# 우선순위: app.py 기본값 < Dockerfile ENV < docker run -e
ENV APP_TITLE="이호건의 방명록" \
    THEME_COLOR="#7C3AED"

# 이 컨테이너가 5000번 포트를 쓴다는 문서(메모)일 뿐, 실제로 열려면 -p 옵션 필요
EXPOSE 5000

# 컨테이너가 시작될 때마다 실행할 명령 (앱 실행). 배열 형태 권장
CMD ["python", "app.py"]
